package punto9;
import punto8.Point;

public class Rectangulo {
	
	private Point puntoA;
	private Point puntoB;
	
	public Rectangulo(Point p1, Point p2) throws Exception {
        if (this.mismoEjeX(p1, p2) || this.mismoEjeY(p1,p2)) {
        	throw new Exception("No es un rectángulo, es una línea!");
        }
		
		this.puntoA = p1;
        this.puntoB = p2;
    }
    
    public int getAncho() {
        return Math.abs(puntoB.getEjeX() - puntoA.getEjeX());
    }
    
    public int getAlto() {
        return Math.abs(puntoB.getEjeY() - puntoA.getEjeY());
    }
    
    public int getArea() {
        return this.getAncho() * this.getAlto();
    }

    public int getPerimetro() {
    	return (this.getAncho()*2 + this.getAlto()*2); 
    }
    
    public boolean esHorizontal(){
    	return this.getAncho() > this.getAlto();
    }
    
    private boolean mismoEjeX(Point p1, Point p2) {
    	return p1.getEjeX() == p2.getEjeX();
    }
    
    private boolean mismoEjeY(Point p1, Point p2) {
    	return p1.getEjeY() == p2.getEjeY();
    }    
    
}
