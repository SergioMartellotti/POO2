package punto8;

public class Point {
	private Integer ejeX;
	private Integer ejeY;
	
	public Point(Integer x, Integer y) {
		ejeX = x;
		ejeY = y;
	}
	
	public Point() {
		ejeX=0;
		ejeY=0;
	}

	public void moverPunto(Integer x, Integer y) {
		this.setEjeX(x);
		this.setEjeY(y);
	}
	
	public Point sumarCon(Point punto) {
		Point puntoNuevo = new Point(this.getEjeX()+punto.getEjeX(), this.getEjeX()+punto.getEjeX());
		return puntoNuevo;
	}
	
	public Integer getEjeX() {
		return ejeX;
	}

	public void setEjeX(Integer ejeX) {
		this.ejeX = ejeX;
	}

	public Integer getEjeY() {
		return ejeY;
	}

	public void setEjeY(Integer ejeY) {
		this.ejeY = ejeY;
	}
	
	
}
