	private Persona personaA;
	private Persona personaB;
	
	@Test
	void testMenorQue() {
		personaA = new Persona("nombreA", LocalDate.of(1980, 5, 15));
		personaA = new Persona("nombreA", LocalDate.of(1990, 4, 14));
		assertEquals(true, personaA.menorQue(personaB));
	}

}
