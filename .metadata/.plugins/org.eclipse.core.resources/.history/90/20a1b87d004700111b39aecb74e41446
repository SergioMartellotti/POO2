package punto9;
import punto8.Point;

public class Rectangulo {
	
	private Point puntoA;
	private Point puntoB;
	
	public Rectangulo(Point p1, Point p2) {
        this.puntoA = p1;
        this.puntoB = p2;
    }
    
    // Método para calcular el ancho (sin ifs)
    public int getAncho() {
        return Math.abs(puntoB.getEjeX() - puntoA.getEjeX());
    }
    
    // Método para calcular el alto (sin ifs)
    public int getAlto() {
        return Math.abs(puntoB.getEjeY() - puntoA.getEjeY());
    }
    
    // Calcular área (siempre positiva)
    public int getArea() {
        return getAncho() * getAlto();
    }

	
}
